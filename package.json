{
  "name": "vibe-app-monorepo",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "mobile:vione:apk": "npm run build:apk --prefix apps/mobile_vione",
    "mobile:vione:apk:local": "npm run build:apk:fast --prefix apps/mobile_vione",
    "mobile:vione:ipa": "npm run build:ipa --prefix apps/mobile_vione",
    "mobile:vione:submit": "npm run submit:ios --prefix apps/mobile_vione",
    "mobile:vione:testflight": "npm run build:ios:submit --prefix apps/mobile_vione",
    "mobile:ceo1983:apk": "npm run build:apk --prefix apps/mobile_ceo1983",
    "mobile:ceo1983:apk:local": "npm run build:apk:fast --prefix apps/mobile_ceo1983",
    "mobile:ceo1983:ipa": "npm run build:ipa --prefix apps/mobile_ceo1983",
    "mobile:ceo1983:submit": "npm run submit:ios --prefix apps/mobile_ceo1983",
    "mobile:ceo1983:testflight": "npm run build:ios:submit --prefix apps/mobile_ceo1983"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "prettier": "^3.2.5",
    "turbo": "^2.1.2",
    "typescript": "^5.8.3"
  }
}
